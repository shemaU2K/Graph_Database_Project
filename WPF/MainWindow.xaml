<Window x:Class="Graph_Database_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:vm="clr-namespace:Graph_Database_WPF.ViewModels"
        mc:Ignorable="d"
        Title="Graph Database Manager v2.1" Height="750" Width="1200"
        Background="#F0F0F0">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="Gray" BorderThickness="0,0,1,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Control Panel" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <TabControl Grid.Row="1">
                    
                    <TabItem Header="Algorithms">
                        <StackPanel Margin="5">
                            <TextBlock Text="Start ID:"/>
                            <TextBox Text="{Binding StartNodeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
                            <TextBlock Text="End ID:"/>
                            <TextBox Text="{Binding EndNodeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="Dijkstra" Command="{Binding RunDijkstraCommand}" Width="70" Margin="2"/>
                                <Button Content="BFS" Command="{Binding RunBFSCommand}" Width="70" Margin="2"/>
                                <Button Content="DFS" Command="{Binding RunDFSCommand}" Width="70" Margin="2"/>
                                <Button Content="Cycles?" Command="{Binding CheckCycleCommand}" Width="70" Margin="2" BorderBrush="Red"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding AlgorithmResult}" TextWrapping="Wrap" Foreground="Blue" Margin="0,10,0,0"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Edit Nodes">
                        <ScrollViewer>
                            <StackPanel Margin="5">
                                <TextBlock Text="ID (Unique):"/>
                                <TextBox Text="{Binding NewNodeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                                <TextBlock Text="Name / Title:"/>
                                <TextBox Text="{Binding NewNodeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                                <TextBlock Text="Extra Info:"/>
                                <TextBox Text="{Binding NewNodeExtra, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <StackPanel>
                                    <Button Content="Add Person (Blue)" Command="{Binding AddPersonNodeCommand}" Background="DodgerBlue" Foreground="White" Margin="0,2"/>
                                    <Button Content="Add City (Orange)" Command="{Binding AddCityNodeCommand}" Background="Orange" Foreground="White" Margin="0,2"/>
                                    <Button Content="Add Company (Green)" Command="{Binding AddCompanyNodeCommand}" Background="SpringGreen" Margin="0,2"/>
                                </StackPanel>

                                <Separator Margin="0,15"/>
                                <TextBlock Text="Remove Node ID:"/>
                                <TextBox Text="{Binding RemoveNodeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                                <Button Content="Delete Node" Command="{Binding RemoveNodeCommand}" Background="#FFCDD2"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Connections">
                        <StackPanel Margin="5">
                            <TextBlock Text="Manual Connection" FontWeight="Bold" Margin="0,5"/>
                            <Border BorderBrush="LightGray" BorderThickness="1" Padding="5" Margin="0,0,0,15" Background="#FAFAFA">
                                <StackPanel>
                                    <TextBlock Text="From Node ID:"/>
                                    <TextBox Text="{Binding ConnSourceId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Padding="3"/>

                                    <TextBlock Text="To Node ID:"/>
                                    <TextBox Text="{Binding ConnTargetId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Padding="3"/>

                                    <Button Content="Connect Manual" Command="{Binding AddConnectionManualCommand}" 
                                            Background="LightBlue" Margin="0,5" Height="25"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Settings (All Methods)" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Text="Weight:"/>
                            <TextBox Text="{Binding DefaultWeight}" Margin="0,0,0,10"/>
                            <TextBlock Text="Role:"/>
                            <TextBox Text="{Binding DefaultRole}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="File / System">
                    <StackPanel Margin="5">
                        <TextBlock Text="Graph Storage" FontWeight="Bold" Margin="0,0,0,5"/>

                        <Button Content="SAVE Graph to File" Command="{Binding SaveToFileCommand}" 
                Height="30" Margin="0,5" Background="LightGreen"/>

                        <Button Content="LOAD Graph from File" Command="{Binding LoadFromFileCommand}" 
                Height="30" Margin="0,5" Background="LightYellow"/>

                        <Separator Margin="0,15"/>

                        <TextBlock Text="Status:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="Gray"/>
                    </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <nodify:NodifyEditor ItemsSource="{Binding Nodes}"
                                 Connections="{Binding Connections}"
                                 ConnectionStartedCommand="{Binding ConnectionStartedCommand}"
                                 ConnectionCompletedCommand="{Binding ConnectionCompletedCommand}"
                                 Background="#1E1E1E" 
                                 GridCellSize="15">

                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:ItemContainer}">
                        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                        <Setter Property="IsDraggable" Value="True"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>

                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                        <Grid Width="70" Height="70">
                            <Grid.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Title, StringFormat='Name: {0}'}"/>
                                </StackPanel>
                            </Grid.ToolTip>
                            <Ellipse Fill="#2D2D30" 
                     Stroke="{Binding Color}" 
                     StrokeThickness="3"/>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="10" 
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="60"/>
                            </StackPanel>

                            <nodify:NodeInput DataContext="{Binding Inputs[0]}"
                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                              IsConnected="True"
                              
                              HorizontalAlignment="Left" 
                              Width="15"
                              
                              Opacity="0"
                              Cursor="Arrow"
                              ToolTip="Input (Drag here to connect)"/>

                            <nodify:NodeOutput DataContext="{Binding Outputs[0]}"
                               Anchor="{Binding Anchor, Mode=OneWayToSource}"
                               IsConnected="True"
                               
                               HorizontalAlignment="Right"
                               Width="15"
                               
                               Opacity="0"
                               Cursor="Hand"
                               ToolTip="Output (Drag to connect)"/>
                        </Grid>
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                        <nodify:LineConnection Source="{Binding Source.Anchor}"
                       Target="{Binding Target.Anchor}" 
                       Stroke="#AAFFFFFF" 
                       StrokeThickness="2"
                       Cursor="Hand"
                       
                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}">

                            <nodify:LineConnection.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Delete Connection" 
                      Command="{Binding PlacementTarget.Tag.DeleteConnectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </nodify:LineConnection.ContextMenu>

                        </nodify:LineConnection>
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>
            </nodify:NodifyEditor>

            <TextBlock Text="Drag nodes to move | Drag port to connect" Margin="10" 
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                       Foreground="Gray" Opacity="0.7" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
